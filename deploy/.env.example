# TomatoDocker Docker 部署环境变量（复制为 deploy/.env 后修改）
# 注意：JWT_SECRET 同时用于 Docker 环境凭据加密，务必使用 >=32 位随机串并妥善保存。
# 修改 JWT_SECRET 后，已保存的 TLS/SSH 凭据将无法解密，需要重新录入环境。

# 宿主机端口（避免与本机已有 MySQL/Redis 冲突）
APP_PORT=8080
MYSQL_PORT=3307
REDIS_PORT=6380

# MySQL root 密码（只允许字母数字，避免 DSN 特殊字符转义问题）
# 注意：该密码只在 MySQL 数据卷首次初始化时生效；已有 mysql-data 卷后再改这里不会改数据库密码。
MYSQL_ROOT_PASSWORD=root123
# Redis 密码，留空表示不启用密码（容器网络内部访问）
REDIS_PASSWORD=

# 必改：JWT 密钥（>=32 位随机串）
JWT_SECRET=change-me-please-use-32chars-random-secret

# 首次启动创建的管理员密码（仅首次生效；之后改密以后台为准）
ADMIN_PASSWORD=Admin@123456

# 可选：预构建镜像地址（release.yml 会发布到 GHCR）
# APP_IMAGE=ghcr.io/cctomato03/tomato-docker:latest

# 可选：定时任务 Shell / 开放接口
SCHEDULER_SHELL_ENABLED=false
INTEGRATION_ENABLED=false
INTEGRATION_API_KEY=
